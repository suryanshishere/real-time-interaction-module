{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollbuzz",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pollbuzz.suryansh.lol", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pollbuzz-db",
      "database_id": "7d2c0b8a-c9d9-467d-af28-3eb30e1e265f",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "POLL_ROOMS", "class_name": "PollRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PollRoom"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
